{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts"],
  // Imports the web bundle (bundler resolution + import.meta.glob); web's own tsc covers its sources.
  "exclude": ["test/static-api.test.ts"]
}
