  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
