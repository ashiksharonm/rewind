{
  "name": "rewind",
  "private": true,
  "version": "1.0.0",
  "description": "Rewind — time-machine debugging for AI agents. Record, fork, and replay agent runs.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "dev:server": "npm run start -w server",
    "dev:web": "npm run dev -w web",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "eval": "npm run eval -w server --",
    "eval:trace": "npm run eval:trace -w server --",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "mcp": "npm run mcp -w server",
    "check:palette": "node scripts/palette-check.mjs"
  }
}
