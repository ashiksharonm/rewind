# No keys are required: without ANTHROPIC_API_KEY the demo agent is simulated and free.
PORT=4600
REWIND_MODE=simulated        # simulated | live
REWIND_AUTOSEED=1            # seed demo traces on first boot
REWIND_DATA_DIR=./server/data
REWIND_MAX_BODY=5mb          # max JSON body, e.g. for OTLP imports
# ANTHROPIC_API_KEY=         # optional: REWIND_MODE=live
# REWIND_URL=http://localhost:4600   # used by the MCP server container
